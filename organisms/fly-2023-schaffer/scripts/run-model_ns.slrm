#!/usr/bin/env bash
#SBATCH --job-name FLY_run-model
#SBATCH --partition=cpu
# --qos=gpu-lim
#SBATCH --gres=shard:4
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=1-01:00:00
#SBATCH --mail-user=a12144285@unet.univie.ac.at
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --output=/lisc/home/user/zimmermann/Files/Workspace/hobe/organisms/fly-2023-schaffer/out/slurm/run-model.%A.out
#SBATCH --error=/lisc/home/user/zimmermann/Files/Workspace/hobe/organisms/fly-2023-schaffer/out/slurm/run-model.%A.err

module load Python/3.12.3-GCCcore-13.3.0
source "${HOME}/.venv/hgm/bin/activate"

python --version
echo "${VIRTUAL_ENV}"


OUT_DIR="/lisc/data/scratch/neurobiology/zimmer/zimmermann/Slurm"
mkdir -p "${OUT_DIR}"


export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_PYTHON_CLIENT_ALLOCATOR=platform
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"

export XLA_FLAGS="--xla_gpu_enable_command_buffer="

export JAX_PLATFORM_NAME=cpu

srun --cpu-bind=none papermill ./run-model_ns.ipynb ./run-model_ns.ipynb --log-output
