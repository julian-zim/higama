#!/usr/bin/env bash
#SBATCH --job-name run-model
#SBATCH --gres=gpu:1
#SBATCH --mem=16G
#SBATCH --cpus-per-task=8
#SBATCH --time=01:00:00
#SBATCH --mail-user=a12144285@unet.univie.ac.at
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --output=/lisc/home/user/zimmermann/Files/Workspace/hobe/worm-2025-fieseler/out/slurm/run-model.%A.out
#SBATCH --error=/lisc/home/user/zimmermann/Files/Workspace/hobe/worm-2025-fieseler/out/slurm/run-model.%A.err

module load Python/3.12.3-GCCcore-13.3.0
source "${HOME}/.venv/hgm/bin/activate"

python --version
echo "${VIRTUAL_ENV}"


OUT_DIR="/lisc/scratch/neurobiology/zimmer/zimmermann/Slurm"
WANDB_DIR="/lisc/home/user/zimmermann/Files/Workspace/hobe/worm-2025-fieseler/out/wandb"
mkdir -p "${OUT_DIR}"
mkdir -p "${WANDB_DIR}"


export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_PYTHON_CLIENT_ALLOCATOR=platform
export WANDB_DIR="${WANDB_DIR}"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"

srun --cpu-bind=none jupyter nbconvert --to notebook --execute model-runall.ipynb --output model-runall.ipynb
